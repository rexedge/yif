generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth required models ────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String   @default("member")

  // Better Auth admin plugin
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  // Extended profile
  phone         String?
  gender        String?
  continent     String?
  country       String?
  stateProvince String?
  cityDistrict  String?
  bio           String?

  // Notification preferences
  notifEventInvites     Boolean @default(true)
  notifNewsletter       Boolean @default(true)
  notifDonationReceipts Boolean @default(true)
  notifMemberUpdates    Boolean @default(true)
  notifScholarshipNews  Boolean @default(true)

  sessions                Session[]
  accounts                Account[]
  member                  Member?
  tickets                 Ticket[]
  donations               Donation[]
  scholarshipApplications ScholarshipApplication[]
  transactions            Transaction[]
  invitations             Invitation[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Better Auth admin plugin
  impersonatedBy String?

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ─── App models ─────────────────────────────────────────────────────────────

// Dynamic membership tiers — admin can create, rename, reorder, or archive
// tiers at any time without a code deploy.
model MembershipTier {
  id          String   @id @default(cuid())
  slug        String   @unique // URL/code key e.g. "silver", "gold"
  name        String           // Display label e.g. "Silver", "Gold"
  description String?
  color       String?          // hex color for badge styling
  badge       String?          // optional label e.g. "Most Popular"
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        Member[]            @relation("MemberCurrentTier")
  pendingMembers Member[]            @relation("MemberPendingTier")
  prices         MembershipPlanPrice[]

  @@map("membership_tier")
}

// Per-tier, per-currency pricing managed by admin.
model MembershipPlanPrice {
  id        String         @id @default(cuid())
  tierId    String
  tier      MembershipTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  currency  String         // NGN | USD | GBP | EUR
  amount    Decimal        @db.Decimal(10, 2)
  isActive  Boolean        @default(true)
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())

  @@unique([tierId, currency])
  @@map("membership_plan_price")
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  PENDING
}

model Member {
  id               String          @id @default(cuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId           String
  tier             MembershipTier  @relation("MemberCurrentTier", fields: [tierId], references: [id])
  status           MembershipStatus @default(PENDING)
  joinedAt         DateTime        @default(now())
  expiresAt        DateTime?
  membershipNumber String?         @unique
  paystackRef      String?
  // Scheduled tier change applied at next renewal (downgrade path)
  pendingTierId    String?
  pendingTier      MembershipTier? @relation("MemberPendingTier", fields: [pendingTierId], references: [id])

  @@map("member")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  tagline     String?
  category    String?
  description String?
  date        DateTime
  endDate     DateTime?
  time        String?
  location    String?
  address     String?
  country     String?
  imageUrl    String?
  agenda      Json?
  speakers    Json?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]
  tiers   EventTicketTier[]

  @@map("event")
}

model EventTicketTier {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal  @db.Decimal(10, 2)
  description String?
  capacity    Int
  sold        Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("event_ticket_tier")
}

model BlogTopic {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  color     String?
  createdAt DateTime   @default(now())

  posts     BlogPost[]

  @@map("blog_topic")
}

model BlogPost {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String
  content     Json
  authorName  String
  authorRole  String
  authorImage String?
  imageUrl    String?
  readTime    Int?
  isPublished Boolean    @default(false)
  publishedAt DateTime?
  topicId     String?
  topic       BlogTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("blog_post")
}

model Invitation {
  id           String    @id @default(cuid())
  email        String
  token        String    @unique
  invitedById  String?
  invitedBy    User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  referralCode String?
  usedAt       DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@map("invitation")
}

enum TicketStatus {
  PENDING
  CONFIRMED
  CANCELLED
  USED
}

model Ticket {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId    String
  event      Event        @relation(fields: [eventId], references: [id])
  tierName   String
  quantity   Int          @default(1)
  status     TicketStatus @default(PENDING)
  reference  String       @unique
  amountPaid Decimal?     @db.Decimal(10, 2)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("ticket")
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Donation {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cause     String
  amount    Decimal        @db.Decimal(10, 2)
  status    DonationStatus @default(PENDING)
  reference String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("donation")
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model ScholarshipApplication {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle       String
  status      ApplicationStatus @default(DRAFT)
  formData    Json
  submittedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, cycle])
  @@map("scholarship_application")
}

// ─── Transactions ───────────────────────────────────────────────────────────

enum TransactionPurpose {
  MEMBERSHIP
  TICKET
  DONATION
  OTHER
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REVERSED
}

model Transaction {
  id              String             @id @default(cuid())
  provider        String             @default("paystack")
  reference       String             @unique
  providerTxId    String?
  purpose         TransactionPurpose @default(OTHER)
  status          TransactionStatus  @default(PENDING)

  // Money (stored in base units, not subunits, for human-readable reports)
  amount          Decimal            @db.Decimal(12, 2)
  fees            Decimal?           @db.Decimal(12, 2)
  netAmount       Decimal?           @db.Decimal(12, 2)
  currency        String             @default("NGN")

  // NGN-equivalent frozen at payment time, for consolidated reporting.
  // baseAmount = amount × fxRate, where fxRate is NGN per 1 unit of `currency`
  // (1 for NGN). Captured once on SUCCESS so historical reports never drift.
  baseAmount      Decimal?           @db.Decimal(14, 2)
  baseCurrency    String             @default("NGN")
  fxRate          Decimal?           @db.Decimal(18, 8)

  // Channel info
  channel         String?
  cardBrand       String?
  cardLast4       String?
  cardBank        String?
  gatewayResponse String?
  ipAddress       String?

  // Customer
  customerEmail   String
  customerName    String?
  customerPhone   String?

  // Linkage (loose FKs — no cascades, tx rows outlive related records)
  userId          String?
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  memberId        String?
  ticketId        String?
  donationId      String?

  // Raw payloads for full audit trail
  metadata        Json?
  rawResponse     Json?

  // Admin annotation
  notes           String?

  paidAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([purpose])
  @@index([userId])
  @@index([createdAt])
  @@index([currency])
  @@index([provider])
  @@map("transaction")
}
